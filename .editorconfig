root = true

# All files
[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
indent_size = 4
charset = utf-8

# JSON files
[*.json]
indent_size = 2

# TypeScript/JavaScript files
[*.{ts,js}]
indent_size = 2
max_line_length = 100

# HTML files
[*.html]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2
